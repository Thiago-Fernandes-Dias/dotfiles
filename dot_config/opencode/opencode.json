{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "lsp": {},
  "plugin": [
    "opencode-agent-skills",
    "openslimedit@latest"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "<CONTEXT7_API_KEY"
      }
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    }
  }
}
